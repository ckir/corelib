# =============================================
# FILE: .env.example
# PURPOSE: Environment variable template for Corelib Monorepo
# Copy to .env and fill in your values
# =============================================

# ---------------------------------------------------------
# APPLICATION SETTINGS
# ---------------------------------------------------------
# Application mode: development | production
# IMPORTANT: Do NOT set MODE=development in production or consuming apps!
# This causes @ckirg/corelib postinstall to skip FFI binary download.
MODE=production

# Log level: trace | debug | info | warn | error | fatal
# trace = per-item (highest volume), debug = per-cycle, info = significant events
LOG_LEVEL=info

# Enable system telemetry in logs (injects CPU, memory, etc. every 5s)
LOG_TELEMETRY=off

# ---------------------------------------------------------
# RUNTIME DETECTION (auto-detected, override only if needed)
# ---------------------------------------------------------
# RUNTIME=node|bun|deno|cloudflare|aws-lambda|gcp-cloudrun

# ---------------------------------------------------------
# CONFIGURATION (CORELIB_ prefix maps to config keys)
# Example: CORELIB_DB_PORT=5432 -> config.db.port = 5432
# Priority: CLI args > Env vars > Config files > Defaults
# ---------------------------------------------------------

# Database (PostgreSQL / libsql / Turso)
# CORELIB_DATABASE_DIALECT=postgres|sqlite
# CORELIB_DATABASE_URL=postgresql://user:pass@host:5432/db
# CORELIB_DATABASE_MAX_CONNECTIONS=10
# CORELIB_DATABASE_SSL=true

# For libsql/Turso:
# CORELIB_DATABASE_DIALECT=sqlite
# CORELIB_DATABASE_URL=libsql://your-db.turso.io
# CORELIB_DATABASE_AUTH_TOKEN=your-auth-token
# CORELIB_DATABASE_LOCAL_PATH=./local.db
# CORELIB_DATABASE_JOURNAL_MODE=WAL

# Retrieve / HTTP Client
# CORELIB_RETRIEVE_TIMEOUT=50000
# CORELIB_RETRIEVE_RETRY_LIMIT=5
# CORELIB_RETRIEVE_RETRY_BACKOFF_LIMIT=3000

# Markets / Financial Data
# CORELIB_MARKETS_NASDAQ_QUOTES_CONCURRENCY_LIMIT=10
# CORELIB_MARKETS_CNN_HEADERS_USER_AGENT=Mozilla/5.0...

# ---------------------------------------------------------
# MARKET DATA API KEYS
# ---------------------------------------------------------
# Alpaca (for AlpacaStreaming)
# APCA_API_KEY_ID=your-alpaca-key-id
# APCA_API_SECRET_KEY=your-alpaca-secret-key
# APCA_API_BASE_URL=https://paper-api.alpaca.markets  # or https://api.alpaca.markets for live

# Finnhub (for FinnhubStreaming)
# FINNHUB_TOKEN=your-finnhub-token

# Yahoo Finance uses public WebSocket (no auth required)

# ---------------------------------------------------------
# CLOUD PROVIDER CREDENTIALS (for ts-cloud deployments)
# ---------------------------------------------------------

# Cloudflare Workers
# CLOUDFLARE_API_TOKEN=your-cf-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CORELIB_TURSO_URL=libsql://...
# CORELIB_TURSO_TOKEN=...

# AWS Lambda
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# GCP Cloud Run
# GCP_PROJECT_ID=your-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------
# EDGE PROXY ENDPOINTS (for RequestProxied / NasdaqPolling)
# ---------------------------------------------------------
# CORELIB_PROXY_URLS=https://proxy1.example.com,https://proxy2.example.com

# ---------------------------------------------------------
# DEVELOPMENT OVERRIDES
# ---------------------------------------------------------
# Force local binary path (bypass postinstall download)
# CORELIB_RUST_BINARY_PATH=./ts-core/corelib-rust.node

# Skip config file loading
# CORELIB_SKIP_CONFIG_FILE=true

# ---------------------------------------------------------
# CI/CD (auto-set in GitHub Actions)
# ---------------------------------------------------------
# GITHUB_ACTIONS=true
# CI=true