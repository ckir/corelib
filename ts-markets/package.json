{
    "name": "@ckirg/corelib-markets",
    "version": "0.2.0",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "watch": "tsup --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . --write --unsafe --max-diagnostics=100",
        "format": "biome format . --write",
        "docs": "typedoc",
        "clean": "del dist"
    },
    "devDependencies": {
        "@types/deno": "catalog:",
        "@types/luxon": "^3.7.1",
        "@types/node": "catalog:",
        "@types/ws": "catalog:",
        "bun-types": "^1.3.14",
        "happy-dom": "^20.10.1",
        "msw": "^2.14.6",
        "typedoc": "^0.28.19",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.12.0",
        "@ckirg/corelib": "workspace:*",
        "@gadicc/yahoo-finance2": "jsr:^3.15.2",
        "ky": "^2.0.2",
        "luxon": "^3.7.2",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "protobufjs": "^8.6.0",
        "serialize-error": "^13.0.1",
        "ws": "^8.21.0"
    }
}