# =============================================
# FILE: rust/Dockerfile.linux
# PURPOSE: Multi-stage Docker build for Linux x64 FFI binaries
# Builds: corelib-rust.node, yahoo_streamer, alpaca_streamer
# =============================================

# ---------------------------------------------------------
# STAGE 1: Build environment with all dependencies
# ---------------------------------------------------------
FROM rust:1.82-slim-bookworm AS builder

# Install system dependencies for OpenSSL, pkg-config, and napi-rs
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Cargo files first for better caching
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/build.rs ./rust/ 2>/dev/null || true

# Copy source code
COPY rust/src ./rust/src

# ---------------------------------------------------------
# STAGE 2: Build the cdylib (.node) and CLI binaries
# ---------------------------------------------------------
FROM builder AS build-release

WORKDIR /app/rust

# Install napi-cli for building the Node.js native addon
RUN cargo install --locked napi-cli@3.7.0

# Build the native module (cdylib) with napi features
# This produces corelib-rust.node
RUN napi build --release --platform linux-x64

# Build CLI binaries with clap feature
RUN cargo build --release --features clap --bin yahoo_streamer --bin alpaca_streamer

# Verify outputs exist
RUN ls -la target/release/corelib-rust.node target/release/yahoo_streamer target/release/alpaca_streamer

# ---------------------------------------------------------
# STAGE 3: Minimal runtime image (for copying artifacts)
# ---------------------------------------------------------
FROM scratch AS artifacts

# Copy the built artifacts
COPY --from=build-release /app/rust/target/release/corelib-rust.node /corelib-rust.node
COPY --from=build-release /app/rust/target/release/yahoo_streamer /yahoo_streamer
COPY --from=build-release /app/rust/target/release/alpaca_streamer /alpaca_streamer