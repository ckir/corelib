{
    "name": "corelib-monorepo",
    "version": "0.4.0",
    "packageManager": "pnpm@11.5.2",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/ws": "catalog:",
        "cross-env": "^10.1.0",
        "del-cli": "^8.0.1",
        "dependency-cruiser": "^18.7.0",
        "msw": "^3.0.3",
        "nx": "^23.3.0",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "ws": "^8.22.0"
    },
    "scripts": {
        "build-all": "pnpm -r build",
        "watch-all": "pnpm -r watch --parallel",
        "test-all": "pnpm -r test",
        "test-all:run": "pnpm -r test:run",
        "test-all:coverage": "pnpm -r test:coverage",
        "typecheck-all": "pnpm -r typecheck",
        "lint-all": "pnpm -r lint",
        "lint:strict": "biome ci ts-core ts-markets ts-cloud probes tests scripts",
        "audit:prod": "pnpm audit --prod --audit-level high",
        "check:browser-bundle": "node scripts/check-browser-bundle.mjs",
        "deps:check": "depcruise --config .dependency-cruiser.cjs ts-core/src ts-markets/src ts-cloud/src",
        "lint:rust": "cargo clippy --manifest-path rust/Cargo.toml --all-targets -- -D warnings",
        "test:rust": "cargo test --manifest-path rust/Cargo.toml -- --test-threads=1",
        "format-all": "pnpm -r format",
        "verify:fast": "pnpm format-all && pnpm lint:strict && pnpm deps:check && pnpm lint-all && pnpm typecheck-all && pnpm site:check:source",
        "verify:full": "pnpm build-all && pnpm check:browser-bundle && pnpm test-all:run",
        "docs": "pnpm run docs-all",
        "docs:rust": "cargo doc --manifest-path rust/Cargo.toml --no-deps",
        "docs-all": "pnpm -r run docs",
        "clean-all": "pnpm exec npx del-cli --force node_modules dist rust/target .nx",
        "test:site": "vitest run --config vitest.config.mts",
        "site:check": "node scripts/check-site.mjs",
        "site:check:source": "node scripts/check-site.mjs --source",
        "test:integration": "pnpm -r --workspace-concurrency=1 run test:integration",
        "test:integration:record": "cross-env INTEGRATION_RECORD=1 pnpm -r --workspace-concurrency=1 run test:integration",
        "test:integration:live": "cross-env INTEGRATION_LIVE=1 pnpm -r --workspace-concurrency=1 run test:integration",
        "test:integration:validate": "tsx tests/integration/coverage-validator.ts",
        "site:build": "node scripts/build-site.mjs",
        "site:preview": "cross-env SITE_BASE= pnpm site:build && cross-env SITE_BASE= node scripts/serve-site.mjs"
    }
}