{
    "name": "@ckir/corelib-cloud",
    "version": "0.1.21",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "wrangler dev",
        "build": "tsup",
        "postbuild": "node -e \"const fs=require('fs');const path=require('path');const awsDir=path.join('dist','aws');const crDir=path.join('dist','cloudrun');[awsDir, crDir].forEach(d => { if(!fs.existsSync(d)) fs.mkdirSync(d, {recursive:true}); const rust=path.join('..','ts-core','corelib-rust.node'); if(fs.existsSync(rust)) { fs.copyFileSync(rust, path.join(d,'corelib-rust.node')); console.log('✅ Copied corelib-rust.node to ' + d); } });\"",
        "watch": "tsup --watch",
        "test": "vitest",
        "test:run": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config vitest.integration.worker.config.ts",
        "test:worker": "vitest --config vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . --write --unsafe --max-diagnostics=100",
        "format": "biome format . --write",
        "docs": "typedoc",
        "clean": "del dist"
    },
    "dependencies": {
        "@ckir/corelib": "workspace:*",
        "@ckir/corelib-markets": "workspace:*",
        "@hono/node-server": "^2.0.4",
        "hono": "^4.12.23",
        "ky": "^2.0.2",
        "serialize-error": "^13.0.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.40.0",
        "@cloudflare/vitest-pool-workers": "^0.16.13",
        "@cloudflare/workers-types": "^4.20260606.1",
        "@types/aws-lambda": "^8.10.161",
        "@types/deno": "catalog:",
        "@types/node": "catalog:",
        "bun-types": "^1.3.14",
        "miniflare": "^4.20260603.0",
        "tsup": "catalog:",
        "typedoc": "^0.28.19",
        "typescript": "catalog:",
        "vite": "^8.0.16",
        "vitest": "catalog:",
        "wrangler": "^4.98.0"
    }
}
