{
    "name": "@ckirg/corelib-cloud",
    "version": "0.3.0",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "wrangler dev",
        "build": "tsup",
        "postbuild": "node -e \"const fs=require('fs');const path=require('path');const awsDir=path.join('dist','aws');const crDir=path.join('dist','cloudrun');[awsDir, crDir].forEach(d => { if(!fs.existsSync(d)) fs.mkdirSync(d, {recursive:true}); const candidates=['../ts-core/corelib-rust.node','../ts-core/dist/corelib-rust.node','../../ts-core/corelib-rust.node']; for(const rust of candidates){ if(fs.existsSync(rust)){ fs.copyFileSync(rust, path.join(d,'corelib-rust.node')); console.log('✅ Copied corelib-rust.node from ' + rust + ' to ' + d); break; } } });\"",
        "watch": "tsup --watch",
        "package:lambda": "bash ../scripts/package-lambda.sh",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config vitest.integration.worker.config.ts",
        "test:worker": "vitest --config vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check . --write --unsafe --max-diagnostics=100",
        "format": "biome format . --write",
        "docs": "typedoc",
        "clean": "del dist"
    },
    "dependencies": {
        "@ckirg/corelib": "workspace:*",
        "@ckirg/corelib-markets": "workspace:*",
        "@hono/node-server": "^2.1.4",
        "hono": "^4.13.13",
        "ky": "^2.2.0",
        "serialize-error": "^13.0.2"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.63.1",
        "@cloudflare/vitest-pool-workers": "^0.23.0",
        "@cloudflare/workers-types": "^4.20260606.1",
        "@types/aws-lambda": "^8.10.164",
        "@types/deno": "catalog:",
        "@types/node": "catalog:",
        "bun-types": "^1.4.2",
        "miniflare": "^4.20260730.0",
        "tsup": "catalog:",
        "typedoc": "^0.28.20",
        "typescript": "catalog:",
        "vite": "^8.3.4",
        "@vitest/coverage-v8": "catalog:",
        "vitest": "catalog:",
        "wrangler": "^4.149.0"
    }
}
